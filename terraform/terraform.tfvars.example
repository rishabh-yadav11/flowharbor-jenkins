# =============================================================================
# terraform.tfvars.example — FlowHarbor Variable Values (Template)
# =============================================================================
# Copy this file to terraform.tfvars and replace the placeholder values with
# your actual domain and hosted zone information.
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   # Edit terraform.tfvars with your values
#   terraform plan
#   terraform apply
# =============================================================================

# The root domain you own and manage in Route53 (e.g., "example.com").
domain_name    = "flowharbor.in"

# Your Route53 hosted zone ID. Find it in the AWS Route53 console under
# "Hosted zones" — it looks like "Z123456789EXAMPLE".
hosted_zone_id = "Z123456789EXAMPLE"

# Toggle CloudFront CDN for production. Set to false to route traffic directly
# to the ALB (useful for debugging or reducing costs during development).
# enable_cloudfront = false

# Secret for the CloudFront → ALB origin-verify header (issue #3).
# REQUIRED when enable_cloudfront = true. Generate with `openssl rand -hex 32`
# and keep out of version control (prefer TF_VAR_cloudfront_origin_verify_token
# env var over terraform.tfvars for real secrets).
# cloudfront_origin_verify_token = "REPLACE-ME-openssl-rand-hex-32"

# Strict CloudFront-only ALB SG (issue #3 follow-up). Default false — enabling
# breaks direct jenkins/testing/staging on the current single-ALB stack.
# Only set true after splitting prod onto a dedicated ALB.
# alb_restrict_to_cloudfront = false

# Jenkins WAF allowlist (issue #4). Default (unset/[]) denies ALL internet
# traffic to jenkins.<domain> at the WAF — set to office/VPN egress CIDRs.
# Prefer env var for real values: TF_VAR_jenkins_allowed_ipv4_cidrs='["203.0.113.0/24"]'
# jenkins_allowed_ipv4_cidrs = ["203.0.113.0/24"]

# WAF brute-force threshold for jenkins.<domain>/login per IP per 5 min.
# jenkins_login_rate_limit = 100
